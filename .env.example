# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the value below.
#
# VITE_BASE_URL
#   The public base path your site is served from. This becomes Vite's `base`.
#
#   • Local development:  leave it as "/" (or delete the .env file entirely).
#
#   • GitHub Pages PROJECT site (most common):
#       https://<username>.github.io/<repository-name>/
#     -> set it to "/<repository-name>/"  (keep both slashes!)
#       e.g. VITE_BASE_URL=/my-homepage/
#
#   • GitHub Pages USER site (repo named <username>.github.io) or a custom
#     domain (CNAME): use "/"
#       VITE_BASE_URL=/
# ---------------------------------------------------------------------------
VITE_BASE_URL=/
